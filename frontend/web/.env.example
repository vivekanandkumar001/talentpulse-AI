# ==============================================================================
# Progeni Atlas ΓÇö Frontend Environment Template (frontend/web/.env.example)
#
# NOTE: The Next.js frontend is engineered to be ZERO-CONFIG for local development.
# All variables below have safe built-in defaults in `src/lib/config.ts` and `next.config.ts`.
# Creating a .env or .env.local file is strictly OPTIONAL.
# ==============================================================================

# LOCAL DEV: leave empty -> the catch-all route falls back to http://127.0.0.1:5000
# PRODUCTION: set NEXT_PUBLIC_API_URL=https://api-atlas.progeni.live in the Vercel
# dashboard (project "progeni-atlas"), NOT in .env.local (which is gitignored).
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# Base origin URL used for phone companion pairing QR codes
# Default: http://localhost:3000 (falls back to window.location.origin in browser)
NEXT_PUBLIC_PUBLIC_BASE_URL=http://localhost:3000

# MediaPipe Face Landmarker task model asset path
# Default: /mediapipe/models/face_landmarker.task
NEXT_PUBLIC_MEDIAPIPE_FACE_MODEL_URL=/mediapipe/models/face_landmarker.task

# Comma-separated hostnames allowed for Next.js remote image optimization
# Default: res.cloudinary.com,progeni.atlas
ALLOWED_IMAGE_HOSTS=res.cloudinary.com,progeni.atlas

# Comma-separated development hostnames/origins allowed by Next.js
# Default: localhost, 127.0.0.1
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# --- Server-only (read by src/proxy.ts; never exposed to the browser) ---------
# Comma-separated email addresses allowed to sign in to the super-admin console.
# Default: empty (super-admin sign-in denied until configured)
SUPER_ADMIN_EMAILS=

# Primary super-admin email (first admin of record when bootstrapping)
PRIMARY_SUPER_ADMIN_EMAIL=

# --- Analytics & Search Console verification (all optional, env-gated) ------
# Google Search Console HTML meta-tag verification token (alternative to DNS TXT).
# Set in Vercel -> Project -> Settings -> Environment Variables. Never commit.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX. Analytics is completely
# disabled (no script injected) when empty.
NEXT_PUBLIC_GA_ID=
# Bing Webmaster Tools meta verification token ("msvalidate.01").
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Optional proctoring switches (client) ------------------------------------
# Mock proctoring signals for UI development without camera/mic hardware.
# Default: false
NEXT_PUBLIC_MOCK_PROCTORING=false

# Verbose proctoring diagnostics in the browser console.
# Default: false
NEXT_PUBLIC_PROCTORING_DEBUG=false

# --- Verified UPI Payment Gateway ---------------------------------------------
NEXT_PUBLIC_MERCHANT_UPI_ID=progeniatlas@ptaxis
NEXT_PUBLIC_MERCHANT_PAYEE_NAME=Progeni Atlas
